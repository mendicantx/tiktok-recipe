<% content_for :title, "Recipe Box" %>

<%= form_with url: recipes_path, method: :get, class: "mb-8 flex gap-2", data: { turbo_frame: "recipes", turbo_action: "advance" } do |f| %>
  <%= f.search_field :q, value: @query, placeholder: "Search by title, ingredient, or creator…", class: "field", autofocus: @query.present? %>
  <%= f.submit "Search", class: "btn-quiet", name: nil %>
<% end %>

<%= turbo_frame_tag "recipes", target: "_top" do %>
  <% if @recipes.any? %>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @recipes.each do |recipe| %>
        <%= link_to recipe, class: "group overflow-hidden rounded-lg border border-line bg-white shadow-sm transition hover:shadow-md" do %>
          <div class="aspect-[4/3] overflow-hidden bg-line/40">
            <% if recipe.cover.attached? %>
              <%= image_tag recipe.cover, alt: "", class: "h-full w-full object-cover transition group-hover:scale-105" %>
            <% else %>
              <div class="flex h-full items-center justify-center font-serif text-4xl text-muted/50"><%= recipe.title.first %></div>
            <% end %>
          </div>
          <div class="p-4">
            <h2 class="font-serif text-lg font-semibold leading-snug group-hover:text-accent"><%= recipe.title %></h2>
            <p class="mt-1 text-sm text-muted">
              <%= [ recipe.creator && "@#{recipe.creator}", recipe.total_time ].compact.join(" · ") %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% elsif @query.present? %>
    <p class="text-muted">No recipes match “<%= @query %>”.</p>
  <% else %>
    <div class="rounded-lg border border-dashed border-line p-12 text-center">
      <p class="font-serif text-xl">No recipes yet.</p>
      <p class="mt-2 text-sm text-muted">Recipes show up here once they're converted from TikTok.</p>
    </div>
  <% end %>
<% end %>
